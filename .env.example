# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/olympiad?schema=public"

# Secret used to derive session token hashes (HMAC key).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Bootstrap Super Admin account, created by `npm run db:seed`.
# The password is hashed with Argon2id before it is stored; it is never
# persisted or logged in plaintext. Use a strong, unique value in production
# and rotate it after the first login.
INITIAL_ADMIN_NAME="Platform Owner"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""

# "true" seeds demo users, a demo contest, problems, permissions and votes.
# Leave unset / "false" in production.
SEED_DEMO_DATA="false"
